VITE_API_BASE_URL=http://127.0.0.1:8000

# Email delivery defaults to Django console output for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Bayad Commercial Activities Company <no-reply@localhost>
EMAIL_TIMEOUT=20
CUSTOMER_EMAIL_VERIFICATION_EXPIRY_MINUTES=10
CUSTOMER_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
CUSTOMER_EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
CUSTOMER_EMAIL_VERIFICATION_MAX_RESENDS=5

# Real SMTP example for Gmail. Use placeholders only; never commit real secrets.
# Gmail normally requires a 16-character App Password when two-step verification is enabled.
# Do not use your normal Gmail account password.
